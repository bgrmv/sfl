{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "schematics": {
    "@schematics/angular": {
      "component": {
        "changeDetection": "OnPush"
      }
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sfl-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        },
        "schematics": {
          "@schematics/angular:component": {
            "styleext": "scss"
          }
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "sfl",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "allowedCommonJsDependencies": ["highcharts"],
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "@fontsource/inter/latin-400.css",
              "@fontsource/inter/latin-ext-400.css",
              "@fontsource/inter/cyrillic-400.css",
              "@fontsource/inter/latin-500.css",
              "@fontsource/inter/latin-ext-500.css",
              "@fontsource/inter/cyrillic-500.css",
              "@fontsource/inter/latin-600.css",
              "@fontsource/inter/latin-ext-600.css",
              "@fontsource/inter/cyrillic-600.css",
              "@fontsource/inter/latin-700.css",
              "@fontsource/inter/latin-ext-700.css",
              "@fontsource/inter/cyrillic-700.css",
              "@fontsource/oswald/latin-500.css",
              "@fontsource/oswald/latin-ext-500.css",
              "@fontsource/oswald/cyrillic-500.css",
              "@fontsource/oswald/latin-600.css",
              "@fontsource/oswald/latin-ext-600.css",
              "@fontsource/oswald/cyrillic-600.css",
              "@fontsource/oswald/latin-700.css",
              "@fontsource/oswald/latin-ext-700.css",
              "@fontsource/oswald/cyrillic-700.css",
              "@fontsource/material-icons/latin-400.css",
              "src/assets/styles/main.scss"
            ],
            "scripts": [],
            "browser": "src/main.ts",
            "stylePreprocessorOptions": {
              "includePaths": ["."]
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": false,
                "fonts": true
              },
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kb",
                  "maximumError": "900kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "polyfills": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sfl-client:build:production"
            },
            "development": {
              "buildTarget": "sfl-client:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": ["sfl.com", "localhost"],
            "ssl": true,
            "sslKey": "./../ssl/localhost.key",
            "sslCert": "./../ssl/localhost.crt"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "sfl-client:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"]
  }
}
