{
  "name": "sfl",
  "private": true,
  "description": "Корень репозитория: общие команды и pre-commit хуки (husky, lint-staged)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "prepare": "husky",
    "check": "node scripts/check.mjs",
    "backup:prod": "node scripts/mongo-backup.mjs dump",
    "backup:verify": "node scripts/mongo-backup.mjs verify",
    "backup:status": "node scripts/mongo-backup.mjs status",
    "dev": "pnpm --parallel --filter ./client --filter ./server-nest run dev",
    "dev:client": "pnpm --filter ./client run dev",
    "dev:server": "pnpm --filter ./server-nest run dev",
    "build:packages": "pnpm --filter \"./packages/*\" run build"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  }
}
