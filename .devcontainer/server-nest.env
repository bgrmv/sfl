# Dev-only values for server-nest/.env inside the dev-container.
# post-create.sh copies this file to server-nest/.env if it does not exist.
STAGE=development

DATABASE_URL=mongodb://mongodb:27017
DATABASE_DB=sfl

PORT=3001
CLIENT_HOSTNAME=https://sfl.com
CLIENT_PORT=4200

ACCESS_TOKEN_SECRET=dev-access-token-secret
REFRESH_TOKEN_SECRET=dev-refresh-token-secret
