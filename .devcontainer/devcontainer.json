{
  "name": "SFL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/sfl",
  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // docker-compose.yml publishes these ports; VS Code must not forward
  // them again to a random local port
  "portsAttributes": {
    "4200": { "label": "client (ng serve)", "protocol": "https", "onAutoForward": "ignore" },
    "3001": { "label": "server-nest", "protocol": "https", "onAutoForward": "ignore" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "HTMLHint.vscode-htmlhint",
        "Angular.ng-template",
        "vitest.explorer",
        "mongodb.mongodb-vscode",
        "mikestead.dotenv",
        "hediet.vscode-drawio",
        "anthropic.claude-code"
      ]
    }
  }
}
