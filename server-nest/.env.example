# Copy to .env and fill in. Variables are validated in src/config/configuration.ts.
# In the dev-container .env is created from .devcontainer/server-nest.env.
STAGE=

DATABASE_URL=
DATABASE_DB=

PORT=
CLIENT_HOSTNAME=
CLIENT_PORT=

# JWT secrets: at least 32 characters each and different from each other, or the server does not start
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional rate limits (defaults in src/config/configuration.ts)
# SIGN_IN_LIMIT=5
# SIGN_IN_WINDOW_SEC=60
# API_LIMIT=300
# API_WINDOW_SEC=60
# Where uploaded photos are kept (S10.19); default ./_media, a volume in production
MEDIA_DIR=
