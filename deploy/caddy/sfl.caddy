# Routes of SFL for the shared edge proxy (copied to /opt/edge/sites/ by the deploy).
# SFL_DOMAIN and SFL_STAGING_DOMAIN come from /opt/edge/.env.

(sfl_common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# Files of the Angular build carry a hash in the name
	@hashed path_regexp hashed ^/.+-[A-Za-z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}

{$SFL_DOMAIN} {
	import sfl_common
	reverse_proxy sfl-prod-app:3001
}

www.{$SFL_DOMAIN} {
	redir https://{$SFL_DOMAIN}{uri} permanent
}

{$SFL_STAGING_DOMAIN} {
	import sfl_common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy sfl-staging-app:3001
}
