# Routes of SFL for the shared edge proxy (copied to /opt/edge/sites/ by the deploy).
# SFL_DOMAIN, SFL_STAGING_DOMAIN, SFL_STAGING_AUTH_USER and SFL_STAGING_AUTH_HASH come from
# /opt/edge/.env (hash: `docker run --rm caddy:2 caddy hash-password`, write `$` as `$$`).

(sfl_common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# Files of the Angular build carry a hash in the name
	@hashed path_regexp hashed ^/.+-[A-Za-z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}

{$SFL_DOMAIN} {
	import sfl_common
	reverse_proxy sfl-prod-app:3001
}

www.{$SFL_DOMAIN} {
	redir https://{$SFL_DOMAIN}{uri} permanent
}

{$SFL_STAGING_DOMAIN} {
	import sfl_common
	header X-Robots-Tag "noindex, nofollow"
	# Staging is closed to strangers; /rest/version stays open for the check of a deploy
	@private not path /rest/version
	basic_auth @private {
		{$SFL_STAGING_AUTH_USER} {$SFL_STAGING_AUTH_HASH}
	}
	reverse_proxy sfl-staging-app:3001
}
